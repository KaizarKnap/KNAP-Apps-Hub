# Voorbeeldconfiguratie voor het inloggen met een Microsoft-werkaccount.
#
# Kopieer dit bestand naar .streamlit/secrets.toml en vul de waarden in.
# secrets.toml staat in .gitignore en hoort daar te blijven: deze repo is
# publiek, een client secret erin is direct misbruikbaar.
#
# Op de server (Streamlit Cloud / Azure) plak je deze inhoud in het
# secrets-veld van de hosting in plaats van in een bestand.
#
# Volledige uitleg: docs/INLOGGEN.md

[auth]
# Waar Microsoft naartoe terugstuurt na het inloggen. Dit adres moet exact
# ook als "Redirect URI" in de Entra-app-registratie staan.
#   lokaal: http://localhost:8501/oauth2callback
#   live:   https://<jouw-app-adres>/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# Versleutelt de sessiecookie. Lange willekeurige string, niet hergebruiken.
# Genereer met: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "VUL_HIER_EEN_LANGE_WILLEKEURIGE_STRING_IN"

[auth.microsoft]
# Uit Entra ID > App-registraties > jouw app
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "de-waarde-van-het-client-secret"
# Zet hier het tenant-ID van Milieu Service Nederland. Met het tenant-ID in
# de URL kunnen accounts van buiten de organisatie niet eens inloggen.
server_metadata_url = "https://login.microsoftonline.com/TENANT_ID/v2.0/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email" }

[access]
# Iedereen met een werkaccount in deze domeinen mag erin.
domeinen = ["milieuservice.nl"]
# Losse uitzonderingen, bijvoorbeeld een externe accountant. Mag leeg blijven.
emails = []
