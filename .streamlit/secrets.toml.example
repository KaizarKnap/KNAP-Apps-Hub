# Voorbeeldconfiguratie voor de KNAP Apps Hub.
#
# Kopieer dit bestand naar .streamlit/secrets.toml en vul in wat je nodig hebt.
# secrets.toml staat in .gitignore en hoort daar te blijven: deze repo is
# publiek.
#
# Live vul je dit niet in een bestand in, maar in Streamlit Community Cloud
# onder Settings > Secrets.
#
# Er zijn twee manieren van inloggen. Je hebt er maar EEN nodig.


# ==========================================================================
# MANIER 1: WACHTWOORD  (het eenvoudigst, geen hulp van IT nodig)
# Uitleg: docs/INLOGGEN-WACHTWOORD.md
# ==========================================================================
# Een regel per collega. Maak die regels niet met de hand: start de app, klap
# "Beheer" open op het inlogscherm, typ een gebruikersnaam en wachtwoord, en
# plak de regel die je krijgt hieronder.

[gebruikers]
# "t.knap"   = "pbkdf2_sha256$210000$3f1a...$9c4e..."
# "p.jansen" = "pbkdf2_sha256$210000$77bd...$1a52..."


# ==========================================================================
# MANIER 2: MICROSOFT-ACCOUNT  (beter, maar vereist een app-registratie)
# Uitleg: docs/INLOGGEN.md
# ==========================================================================
# Is dit blok volledig ingevuld, dan gebruikt de app deze manier en negeert
# hij [gebruikers]. Laat het staan zoals het is als je manier 1 gebruikt.

[auth]
# Waar Microsoft naartoe terugstuurt na het inloggen. Dit adres moet exact
# ook als "Redirect URI" in de Entra-app-registratie staan.
#   lokaal: http://localhost:8501/oauth2callback
#   live:   https://<jouw-subdomein>.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# Versleutelt de sessiecookie. Lange willekeurige string, niet hergebruiken.
# Genereren in PowerShell, zonder Python:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
cookie_secret = "VUL_HIER_EEN_LANGE_WILLEKEURIGE_STRING_IN"

[auth.microsoft]
# Uit Entra ID > App-registraties > jouw app
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "de-waarde-van-het-client-secret"
# Zet hier het tenant-ID van Milieu Service Nederland. Met het tenant-ID in
# de URL kunnen accounts van buiten de organisatie niet eens inloggen.
server_metadata_url = "https://login.microsoftonline.com/TENANT_ID/v2.0/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email" }

# Wie mag erin bij manier 2. Geldt niet voor manier 1.
[access]
domeinen = ["milieuservice.nl"]
emails = []
